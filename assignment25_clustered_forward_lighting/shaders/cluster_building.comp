#version 450

layout(local_size_x = 16, local_size_y = 9, local_size_z = 4) in;

struct PointLight {
    vec4 positionRadius; // xyz: world pos, w: radius
    vec4 colorIntensity; // rgb: color, w: intensity
};

layout(std430, set = 0, binding = 0) readonly buffer LightBuffer {
    PointLight lights[];
};

struct ClusterAABB {
    vec4 minPoint;
    vec4 maxPoint;
};

layout(std430, set = 0, binding = 1) writeonly buffer ClusterAABBBuffer {
    ClusterAABB clusters[];
};

layout(push_constant) uniform PushConstants {
    mat4 invProjection;
    vec2 screenSize;
    float zNear;
    float zFar;
    uint totalLights;
} pc;

void main() {
    uvec3 clusterID = gl_GlobalInvocationID;
    uint clusterIndex = clusterID.x + clusterID.y * 16 + clusterID.z * (16 * 9);

    // Compute cluster tile bounding box in view space
    vec2 minScreen = vec2(clusterID.xy) / vec2(16.0, 9.0);
    vec2 maxScreen = vec2(clusterID.xy + uvec2(1, 1)) / vec2(16.0, 9.0);

    float nearSlice = -pc.zNear * pow(pc.zFar / pc.zNear, float(clusterID.z) / 24.0);
    float farSlice  = -pc.zNear * pow(pc.zFar / pc.zNear, float(clusterID.z + 1) / 24.0);

    ClusterAABB aabb;
    aabb.minPoint = vec4(minScreen * 2.0 - 1.0, nearSlice, 1.0);
    aabb.maxPoint = vec4(maxScreen * 2.0 - 1.0, farSlice, 1.0);

    clusters[clusterIndex] = aabb;
}
