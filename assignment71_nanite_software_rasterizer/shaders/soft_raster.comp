#version 460
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct MicroTriangle {
    vec4 v0; // xy = Screen pos, z = Depth, w = Unused
    vec4 v1;
    vec4 v2;
    uint triId;
    uint colorId;
    uint pad0;
    uint pad1;
};

layout(std430, set = 0, binding = 0) readonly buffer TriangleBuffer {
    MicroTriangle triangles[];
};

layout(std430, set = 0, binding = 1) buffer VisibilityBuffer {
    uint64_t pixels[]; // Packed Depth (MSB 32) + TriID (LSB 32)
};

layout(push_constant) uniform RasterPushConstants {
    uint numTriangles;
    int screenWidth;
    int screenHeight;
    float time;
};

float edgeFunction(vec2 a, vec2 b, vec2 c) {
    return (c.x - a.x) * (b.y - a.y) - (c.y - a.y) * (b.x - a.x);
}

void main() {
    uint triIndex = gl_GlobalInvocationID.x;
    if (triIndex >= numTriangles) return;

    MicroTriangle tri = triangles[triIndex];

    vec2 p0 = tri.v0.xy;
    vec2 p1 = tri.v1.xy;
    vec2 p2 = tri.v2.xy;

    float area = edgeFunction(p0, p1, p2);
    if (area <= 0.0) return; // Backface culling

    // Compute bounding box clamped to screen
    float minX = max(0.0, floor(min(min(p0.x, p1.x), p2.x)));
    float maxX = min(float(screenWidth - 1), ceil(max(max(p0.x, p1.x), p2.x)));
    float minY = max(0.0, floor(min(min(p0.y, p1.y), p2.y)));
    float maxY = min(float(screenHeight - 1), ceil(max(max(p0.y, p1.y), p2.y)));

    float invArea = 1.0 / area;

    for (int y = int(minY); y <= int(maxY); ++y) {
        for (int x = int(minX); x <= int(maxX); ++x) {
            vec2 p = vec2(float(x) + 0.5, float(y) + 0.5);

            float w0 = edgeFunction(p1, p2, p);
            float w1 = edgeFunction(p2, p0, p);
            float w2 = edgeFunction(p0, p1, p);

            if (w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0) {
                float b0 = w0 * invArea;
                float b1 = w1 * invArea;
                float b2 = w2 * invArea;

                float depth = b0 * tri.v0.z + b1 * tri.v1.z + b2 * tri.v2.z;
                if (depth < 0.0 || depth > 1.0) continue;

                uint depthUint = floatBitsToUint(depth);
                uint64_t packedVal = (uint64_t(depthUint) << 32) | uint64_t(tri.triId);

                uint pixelIdx = uint(y * screenWidth + x);
                atomicMin(pixels[pixelIdx], packedVal);
            }
        }
    }
}
