#version 450

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 pos; // xyz = pos, w = lifetime
    vec4 vel; // xyz = vel, w = mass
    vec4 color;
};

layout(std430, set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform PushConstants {
    float dt;
    float time;
    uint particleCount;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particleCount) return;

    Particle p = particles[idx];

    // Lorenz Attractor Physics Simulation
    float s = 10.0;
    float r = 28.0;
    float b = 8.0 / 3.0;

    vec3 pos = p.pos.xyz;
    vec3 dPos = vec3(
        s * (pos.y - pos.x),
        pos.x * (r - pos.z) - pos.y,
        pos.x * pos.y - b * pos.z
    ) * 0.005;

    p.pos.xyz += dPos * pc.dt * 60.0;

    // Color gradient based on velocity speed
    float speed = length(dPos) * 20.0;
    p.color = vec4(mix(vec3(0.1, 0.5, 1.0), vec3(1.0, 0.2, 0.1), clamp(speed, 0.0, 1.0)), 1.0);

    particles[idx] = p;
}
